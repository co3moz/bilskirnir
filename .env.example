# Use 0.0.0.0 for LAN access. Default: localhost only.
BIND_ADDRESS=127.0.0.1
PORT=8080
MANAGER_CONTAINER=bilskirnir-manager
AUTH_MODE=password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional root agent access at /mcp, to every container (called MCP_ENABLED before 0.7.0). MCP
# endpoints made on the dashboard answer without it. Use a separate randomly generated token,
# which opens the endpoints too. MCP_AUTH_MODE=none drops the token: anyone who reaches the
# address can use /mcp and every endpoint, while ROOT_MCP_ENABLED=true.
ROOT_MCP_ENABLED=false
MCP_TOKEN=
MCP_AUTH_MODE=token
SECURE_COOKIE=false
# Used by compose.ghcr.yml. Pin a version or digest for reproducible upgrades.
MANAGER_IMAGE=ghcr.io/co3moz/bilskirnir:latest
DESKTOP_IMAGE=ghcr.io/co3moz/bilskirnir/ubuntu-xfce:24.04
WSL_GPU=true
# Enable CUDA through NVIDIA Container Toolkit.
NVIDIA_COMPUTE=true
# Mesa D3D12 adapter: NVIDIA / AMD / Intel, or part of the model name.
GPU_ADAPTER=
AUDIO_ENABLED=true
MICROPHONE_ENABLED=true
# Container features. INTERNET_ENABLED, SUDO_ENABLED and GAMEPAD_ENABLED, like AUDIO_ENABLED and
# MICROPHONE_ENABLED, switch one off for the whole installation; WSL_GPU and NVIDIA_COMPUTE do
# that for the GPU. A new container cannot get a switched-off feature, and one that has it keeps
# it in its settings. The _DEFAULT settings are what the create form starts with and what a create
# request gets when it leaves a feature out.
INTERNET_ENABLED=true
SUDO_ENABLED=true
GAMEPAD_ENABLED=true
GPU_DEFAULT=true
INTERNET_DEFAULT=true
SUDO_DEFAULT=true
AUDIO_DEFAULT=false
MICROPHONE_DEFAULT=false
GAMEPAD_DEFAULT=false
# Lets desktops create user namespaces, which Chrome, Edge and Electron apps sandbox with.
# false keeps Docker's default seccomp profile; those apps then start only with --no-sandbox.
DESKTOP_USER_NAMESPACES=true
# Per-file upload limit in MiB. Two transfers can run simultaneously.
UPLOAD_MAX_MB=1024
# Largest image or volume archive an import accepts, in MiB after decompression. Image archives hold every layer.
IMAGE_ARCHIVE_MAX_MB=65536
# The list the Templates page reads in the browser. Empty uses the Bilskirnir wiki; none turns the page off.
TEMPLATES_URL=
# The label a volume needs to be listed and mounted, key or key=value. Empty keeps the label
# Bilskirnir gives every volume it creates; none shows every Docker volume.
VOLUME_FILTER=
# Look up the newest release on GitHub every six hours and show it in the dashboard, which in
# the WSL package can also run the update. false turns both off.
UPDATE_CHECK=true
DESKTOP_HOST=localhost
# localhost and private IPs are allowed. Add DNS names separated by commas.
ALLOWED_HOSTS=localhost
HTTPS_PORT=8443


MANAGER_DATA_VOLUME=bilskirnir-data
