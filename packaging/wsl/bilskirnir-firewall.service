[Unit]
Description=Restore Docker's firewall rules after another WSL distribution clears them
# Ordering only: the watcher restarts Docker, so it must not be stopped or restarted with it.
After=docker.service

[Service]
ExecStart=/usr/lib/wsl/firewall-watch.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
