[Unit]
Description=Run bilskirnir update for the Bilskirnir dashboard
Documentation=https://github.com/co3moz/bilskirnir/blob/master/docs/WSL_PACKAGE.md#update-from-the-dashboard
After=docker.service

[Service]
Type=oneshot
# The request moves aside first, so the path unit does not start this again once it ends. It names
# the dashboard's job, which the manager matches.
ExecStartPre=/bin/mv -f /opt/bilskirnir/update/request /opt/bilskirnir/update/started
ExecStart=/bin/sh -c 'exec /usr/local/bin/bilskirnir update >/opt/bilskirnir/update/log 2>&1'
# How the update ended, written after its last output and renamed into place, so the manager has
# the whole log once this is there.
ExecStopPost=/bin/sh -c 'echo "$$SERVICE_RESULT $$EXIT_STATUS" >/opt/bilskirnir/update/exit.new && mv -f /opt/bilskirnir/update/exit.new /opt/bilskirnir/update/exit'
TimeoutStartSec=2h
