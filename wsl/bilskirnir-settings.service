[Unit]
Description=Apply a settings change from the Bilskirnir dashboard
Documentation=https://github.com/co3moz/bilskirnir/blob/master/docs/WSL_PACKAGE.md#settings-from-the-dashboard
After=docker.service

[Service]
Type=oneshot
# The request moves aside first, so the path unit does not start this again once it ends. Its
# first line names the dashboard's job, which the manager matches; the command reads the rest
# and accepts only the settings the dashboard may change.
ExecStartPre=/bin/mv -f /opt/bilskirnir/update/settings-request /opt/bilskirnir/update/settings-started
ExecStart=/bin/sh -c 'exec /usr/local/bin/bilskirnir apply-settings /opt/bilskirnir/update/settings-started >/opt/bilskirnir/update/settings-log 2>&1'
# How the change ended, written after its last output and renamed into place, so the manager has
# the whole log once this is there.
ExecStopPost=/bin/sh -c 'echo "$$SERVICE_RESULT $$EXIT_STATUS" >/opt/bilskirnir/update/settings-exit.new && mv -f /opt/bilskirnir/update/settings-exit.new /opt/bilskirnir/update/settings-exit'
TimeoutStartSec=15min
