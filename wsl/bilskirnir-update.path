[Unit]
Description=Take update requests from the Bilskirnir dashboard
Documentation=https://github.com/co3moz/bilskirnir/blob/master/docs/WSL_PACKAGE.md#update-from-the-dashboard

[Path]
# The manager sees this folder at /update and leaves a request in it; see src/releases.rs. The
# package and bilskirnir update make the folder, and systemd watches for it until it is there.
PathExists=/opt/bilskirnir/update/request

[Install]
WantedBy=multi-user.target
