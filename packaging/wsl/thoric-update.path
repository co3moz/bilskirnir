[Unit]
Description=Take update requests from the Thoric dashboard
Documentation=https://github.com/co3moz/thoric/blob/master/docs/WSL_PACKAGE.md#update-from-the-dashboard

[Path]
# The manager sees this folder at /update and leaves a request in it; see
# core/manager/src/releases.rs. The package and thoric update make the folder, and systemd
# watches for it until it is there.
PathExists=/opt/thoric/update/request

[Install]
WantedBy=multi-user.target
